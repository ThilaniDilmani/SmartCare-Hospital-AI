    {
      "cell_type": "markdown",
      "source": [
        "## 3.14 Create Clinical Features"
      ],
      "metadata": {
        "id": "C7isQ_dAGrlt"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "df_processed['pulse_pressure'] = (\n",
        "    df_processed['systolic_bp'] -\n",
        "    df_processed['diastolic_bp']\n",
        ")\n",
        "\n",
        "df_processed['mean_arterial_pressure'] = (\n",
        "    df_processed['systolic_bp'] +\n",
        "    (2 * df_processed['diastolic_bp'])\n",
        ") / 3\n",
        "\n",
        "df_processed['age_group'] = pd.cut(\n",
        "    df_processed['age'],\n",
        "    bins=[0, 18, 35, 50, 65, float('inf')],\n",
        "    labels=[\n",
        "        'Child',\n",
        "        'Young Adult',\n",
        "        'Adult',\n",
        "        'Middle Aged',\n",
        "        'Senior'\n",
        "    ],\n",
        "    include_lowest=True\n",
        ")\n",
        "\n",
        "df_processed['bmi_category'] = pd.cut(\n",
        "    df_processed['bmi'],\n",
        "    bins=[0, 18.5, 25, 30, float('inf')],\n",
        "    labels=[\n",
        "        'Underweight',\n",
        "        'Normal',\n",
        "        'Overweight',\n",
        "        'Obese'\n",
        "    ],\n",
        "    include_lowest=True\n",
        ")\n",
        "\n",
        "print(\"Clinical features created successfully.\")\n",
        "\n",
        "print(\n",
        "    df_processed[\n",
        "        [\n",
        "            'pulse_pressure',\n",
        "            'mean_arterial_pressure',\n",
        "            'age_group',\n",
        "            'bmi_category'\n",
        "        ]\n",
        "    ].head()\n",
        ")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "syIty4IdGq9L",
        "outputId": "903e0487-0fa1-416e-b0cc-e4cbc0cd5c66"
      },
      "execution_count": null,
