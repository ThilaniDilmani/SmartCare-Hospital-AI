        "## 3.11 Validate Clinical Value Ranges"
      ],
      "metadata": {
        "id": "AbmARQA0F-_g"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "valid_ranges = {\n",
        "    'age': (0, 120),\n",
        "    'systolic_bp': (70, 250),\n",
        "    'diastolic_bp': (40, 150),\n",
        "    'blood_sugar_mg_dl': (40, 500),\n",
        "    'cholesterol_mg_dl': (80, 500),\n",
        "    'bmi': (10, 70)\n",
        "}\n",
        "\n",
        "range_validation = []\n",
        "\n",
        "for column, (minimum, maximum) in valid_ranges.items():\n",
        "    invalid_count = (\n",
        "        (df_processed[column] < minimum) |\n",
        "        (df_processed[column] > maximum)\n",
        "    ).sum()\n",
        "\n",
        "    range_validation.append({\n",
        "        'Attribute': column,\n",
        "        'Minimum Valid Value': minimum,\n",
        "        'Maximum Valid Value': maximum,\n",
        "        'Invalid Value Count': invalid_count\n",
        "    })\n",
        "\n",
        "range_validation_df = pd.DataFrame(range_validation)\n",
        "range_validation_df"
      ],
