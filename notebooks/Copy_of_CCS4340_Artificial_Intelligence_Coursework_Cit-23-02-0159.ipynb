        "## 3.3 Handle Missing Values in the Room Type Attribute"
      ],
      "metadata": {
        "id": "MG8665ocC1Ex"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "df_processed.loc[\n",
        "    (df_processed['admitted'] == 0) &\n",
        "    (df_processed['room_type'].isnull()),\n",
        "    'room_type'\n",
        "] = 'Not Applicable'\n",
        "\n",
        "df_processed.loc[\n",
        "    (df_processed['admitted'] == 1) &\n",
        "    (df_processed['room_type'].isnull()),\n",
        "    'room_type'\n",
        "] = 'Unknown'\n",
        "\n",
        "print(\"Missing values remaining in room_type:\")\n",
        "print(df_processed['room_type'].isnull().sum())\n",
        "\n",
        "print(\"\\nRoom type value counts:\")\n",
        "print(df_processed['room_type'].value_counts())"
      ],
      "metadata": {
